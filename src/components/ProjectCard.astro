---
import type { CollectionEntry } from 'astro:content';
import Stat from './Stat.astro';
interface Props { project: CollectionEntry<'projects'>; big?: boolean; }
const { project, big = false } = Astro.props;
const d = project.data;
const ring = { lime: 'hover:border-lime/60', cyan: 'hover:border-cyan/60', magenta: 'hover:border-magenta/60', amber: 'hover:border-amber/60' }[d.accent];
const badge = { live: 'Live', 'in-development': 'In development', research: 'Research', alpha: 'Alpha', planning: 'Planning', archived: 'Earlier' }[d.status];
---
<a href={`/projects/${project.id}`} class={`group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-line bg-surface p-6 transition-all hover:-translate-y-0.5 ${ring} ${big ? 'md:col-span-2 md:row-span-2 md:p-8' : ''}`}>
  <div>
    <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-wider text-muted">
      <span class="rounded-full border border-line px-2 py-0.5">{badge}</span>
      {d.visibility === 'private' && <span class="rounded-full border border-line px-2 py-0.5">Private</span>}
    </div>
    <h3 class={`font-semibold tracking-tight ${big ? 'text-3xl md:text-4xl' : 'text-xl'}`}>{d.title}</h3>
    <p class="mt-2 max-w-prose text-muted">{d.tagline}</p>
  </div>
  {big && d.image && <img src={d.image} alt="" class="mt-6 aspect-[16/9] w-full rounded-xl border border-line object-cover object-top opacity-90 transition-opacity group-hover:opacity-100" loading="eager" />}
  {d.metrics.length > 0 && (
    <div class={`mt-6 grid gap-4 ${big ? 'grid-cols-2 md:grid-cols-3' : 'grid-cols-2'}`}>
      {d.metrics.slice(0, big ? 3 : 2).map((m) => <Stat value={m.value} label={m.label} accent={d.accent} size={big ? 'lg' : 'sm'} />)}
    </div>
  )}
  <div class="mt-6 flex flex-wrap gap-2 text-xs text-muted">{d.stack.slice(0, 5).map((s) => <span class="rounded bg-surface-2 px-2 py-1">{s}</span>)}</div>
</a>
