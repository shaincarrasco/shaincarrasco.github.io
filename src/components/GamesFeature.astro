---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const ROBLOX = 'https://www.roblox.com/games/92465829726635';
const badges: [string, string][] = [
  ['games/badge-welcome.png', 'Welcome badge'],
  ['games/badge-streak7.png', 'Seven-day streak badge'],
  ['games/badge-flawless.png', 'Flawless run badge'],
  ['games/badge-prestige.png', 'Prestige badge'],
  ['games/badge-diamond.png', 'Diamond stone badge'],
];
const items: [string, string][] = [
  ['games/item-scrap_metal.png', 'Scrap Metal item card'],
  ['games/item-canned_food.png', 'Canned Food item card'],
  ['games/item-water_bottle.png', 'Water Bottle item card'],
  ['games/item-pipe_wrench.png', 'Pipe Wrench item card'],
  ['games/item-duct_tape.png', 'Duct Tape item card'],
  ['games/item-crowbar.png', 'Crowbar item card'],
];
---
<section id="games" class="mx-auto max-w-[1280px] px-5 py-24" aria-labelledby="games-title">
  <H id="games-title" class={`h2 ${H === 'h1' ? 'text-[48px] md:text-[80px]' : 'text-[40px] md:text-[56px]'}`}>Roblox games</H>
  <p class="mt-5 max-w-[860px] text-[20px] leading-[1.4] md:text-2xl">
    I make Roblox games with my friend Trip under <a href="https://www.roblox.com/communities/7205703" class="link">Plymouth Experiences</a>,
    our small studio in Chicago. Each of us works with our own Claude Code agent, the two agents coordinate through a shared repo,
    and a squad of playtest agents plays every build in Studio before a person does.
  </p>

  <!-- Be a Stone -->
  <article class="mt-14 grid gap-10 border-t border-rule pt-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
    <a href={ROBLOX} class="block self-start border border-rule" aria-label="Play Be a Stone on Roblox">
      <Image src={asset('games/be-a-stone-thumb.png')} alt="Be a Stone: four stones rolling through neon, snow, rainbow and sky worlds" widths={[480, 768]} sizes="(min-width: 1024px) 700px, calc(100vw - 40px)" class="block h-auto w-full" loading="lazy" />
    </a>
    <div>
      <p class="text-[15px] text-chalk-dim">Published on Roblox, September 2026</p>
      <h3 class="mt-2 text-[34px] font-extrabold leading-[1.02] tracking-[-0.03em] md:text-5xl">Be a Stone</h3>
      <p class="mt-4 text-lg leading-[1.4]">
        An incremental simulator. Roll a stone until it is perfectly smooth, sell it for gems, and rebirth into the next of 20
        rocks. Race a see-through ghost of your own best run on every level, roll an endless sky road, fight in the arena, and
        join the paid Quarry Club for daily rewards.
      </p>
      <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
        <div><dt class="big text-[32px]">13</dt><dd class="mt-1 text-[15px] leading-snug text-chalk-dim">worlds, each generated by a build script</dd></div>
        <div><dt class="big text-[32px]">50K</dt><dd class="mt-1 text-[15px] leading-snug text-chalk-dim">lines of Luau across 162 scripts</dd></div>
      </dl>
      <ul class="mt-6 flex gap-3" aria-label="Badges in the game">
        {badges.map(([src, alt]) => (
          <li><Image src={asset(src)} alt={alt} widths={[56, 112]} sizes="56px" class="block h-14 w-14 rounded-full" loading="lazy" /></li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[17px] font-semibold">
        <a href={ROBLOX} class="link">Play it on Roblox</a>
        <a href="/projects/roblox-games/" class="link">How it's built</a>
      </div>
    </div>
  </article>

  <!-- Scrap City -->
  <article class="mt-14 grid gap-10 border-t border-rule pt-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
    <div>
      <p class="text-[15px] text-chalk-dim">In development with Trip</p>
      <h3 class="mt-2 text-[34px] font-extrabold leading-[1.02] tracking-[-0.03em] md:text-5xl">Scrap City</h3>
      <p class="mt-4 text-lg leading-[1.4]">
        Open-world urban survival. Spawn with nothing, search dumpsters and trash piles for food, water, weapons and materials,
        build a base from what you find, then team up with other players or fight them for it.
      </p>
      <p class="mt-4 text-[17px] leading-[1.4] text-chalk-dim">
        Every item has a card drawn from its in-game 3D model. The world is a city of neighborhoods, a downtown, a rail line and
        police, designed across 26 design documents.
      </p>
    </div>
    <ul class="grid grid-cols-3 gap-3 self-start" aria-label="Scrap City item cards">
      {items.map(([src, alt]) => (
        <li><Image src={asset(src)} alt={alt} widths={[200, 400]} sizes="(min-width: 1024px) 220px, 30vw" class="block h-auto w-full" loading="lazy" /></li>
      ))}
    </ul>
  </article>

  <!-- How we build -->
  <article class="mt-14 border-t border-rule pt-12">
    <h3 class="text-2xl font-semibold">How we build them</h3>
    <div class="mt-5 grid gap-8 text-lg leading-[1.4] md:grid-cols-3">
      <p><b>A shared engine.</b> One Luau engine every game uses: boot, networking, saved player data with ProfileStore, input validation, and a probe for automated tests. Fix it once and every game gets the fix.</p>
      <p><b>Two agents, one repo.</b> Trip's Claude and mine leave each other messages, claim files before editing, and record decisions, so neither overwrites the other's work.</p>
      <p><b>A playtest squad.</b> Five agents play each build in Studio: an explorer, a first-timer, a grinder, a mobile player and an exploiter, plus an economy analyst and a code reviewer.</p>
    </div>
  </article>
</section>
