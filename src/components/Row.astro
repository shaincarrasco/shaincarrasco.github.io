---
import { STATUS_LABEL } from '../lib/status';
import type { CollectionEntry } from 'astro:content';
interface Props { p: CollectionEntry<'projects'> }
const { p } = Astro.props;
const d = p.data;
const status = STATUS_LABEL[d.status];
const m = d.metrics.find((x) => x.kind === 'measured');
const number = m ? `${m.value} ${m.label}` : '';
---
<li class="border-b border-rule">
  <a href={`/projects/${p.id}/`} class="row grid items-baseline gap-x-8 gap-y-2 py-7 md:grid-cols-[320px_minmax(0,1fr)_240px_90px]">
    <span class="row-title text-[26px] font-semibold leading-[1.1] tracking-[-0.02em] md:text-[32px]">{d.title}</span>
    <span class="text-lg leading-[1.35]">{d.short ?? d.tagline}</span>
    <span class="text-lg leading-[1.35]">{number}</span>
    <span class="text-[15px] text-chalk-dim md:text-right">{status}</span>
  </a>
</li>
