---
interface Props { value: string; label: string; source?: string; accent?: string; size?: 'sm' | 'lg'; }
const { value, label, source, accent = 'lime', size = 'lg' } = Astro.props;
const color = { lime: 'text-lime', cyan: 'text-cyan', magenta: 'text-magenta', amber: 'text-amber' }[accent] ?? 'text-lime';
---
<div class="flex flex-col gap-1">
  <span class={`num font-semibold leading-none ${color} ${size === 'lg' ? 'text-3xl md:text-4xl' : 'text-xl'}`}>{value}</span>
  <span class="text-sm text-muted">{label}{source && <a href={source} class="ml-1 text-muted/60 hover:text-text" title="Source">↗</a>}</span>
</div>
