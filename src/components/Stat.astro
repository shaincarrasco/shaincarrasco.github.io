---
interface Props { value: string; label: string; source?: string; accent?: string; size?: 'sm' | 'lg'; }
const { value, label, source, accent = 'lime', size = 'lg' } = Astro.props;
const color = 'text-amber';
---
<div class="flex flex-col gap-1">
  <span class={`font-extrabold tracking-[-0.03em] leading-none ${color} ${size === 'lg' ? 'text-3xl md:text-4xl' : 'text-xl'}`}>{value}</span>
  <span class="text-sm text-chalk-dim">{label}{source && <a href={source} class="ml-1 text-chalk-dim hover:text-amber" title="Source">↗</a>}</span>
</div>
