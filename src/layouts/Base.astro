---
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; }
const { title, description, image = '/img/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['/projects', 'Work'], ['/now', 'Now'], ['/about', 'About']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Shain Carrasco" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-night text-chalk">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-amber focus:text-night focus:px-3 focus:py-1">Skip to content</a>
    <header>
      <div class="mx-auto flex max-w-[1280px] items-center justify-between px-5 pt-7 text-base sm:text-lg">
        <a href="/" class="whitespace-nowrap font-semibold">Shain Carrasco</a>
        <nav class="flex gap-4 sm:gap-8">
          {nav.map(([href, label]) => <a href={href} class="hover:text-amber">{label}</a>)}
          <a href="https://github.com/shaincarrasco" class="hover:text-amber" rel="me">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-24 border-t border-rule">
      <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-4 px-5 py-10 text-[15px] text-chalk-dim">
        <span>Shain Carrasco, Chicago, {new Date().getFullYear()}</span>
        <div class="flex gap-6">
          <a href="https://github.com/shaincarrasco" class="hover:text-chalk">GitHub</a>
          <a href="https://climbintel.com" class="hover:text-chalk">Climb Intel</a>
          <a href="/rss.xml" class="hover:text-chalk">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
