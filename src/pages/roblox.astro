---
import Base from '../layouts/Base.astro';
const games = [
  { name: 'Scrap City', blurb: 'Open-world urban survival. Search dumpsters for food, water, weapons and materials, build a base from what you find, then team up with other players or fight them.' },
  { name: 'Be a Stone', blurb: 'Roll a stone through adventure levels, polish it, and rebirth into rarer stones. Hardcore mode runs nine stages on one life, with ghost replays and a global leaderboard.' },
  { name: 'Canopy Bureau', blurb: 'A co-op squirrel detective game. Solve cases by exploring living treetop districts, finding clues in any order you like.' },
  { name: 'Sailing simulator', blurb: 'Sailing physics: waves, wind, sails, rudder, heel and capsize.' },
];
---
<Base title="Games — Shain Carrasco" description="Roblox games in development with Plymouth Experiences, a small Chicago studio, plus the studio toolkit behind them.">
  <div class="mx-auto max-w-[1280px] px-5 py-16">
    <p class="text-sm uppercase tracking-[0.2em] text-amber">Roblox · Plymouth Experiences</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Games</h1>
    <p class="mt-4 max-w-2xl text-chalk-dim">Built with <a href="https://www.roblox.com/communities/7205703" class="text-text underline underline-offset-4">Plymouth Experiences</a>, a small Chicago game studio. All in development, not public yet.</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {games.map(g => <div class=" border border-rule bg-night-2 p-6"><span class="text-xs uppercase tracking-wider text-chalk-dim">In development</span><h2 class="mt-2 text-2xl font-semibold tracking-tight">{g.name}</h2><p class="mt-2 text-chalk-dim">{g.blurb}</p></div>)}
    </div>
    <div class="mt-10  border border-rule bg-night-2 p-6">
      <span class="text-xs uppercase tracking-wider text-chalk-dim">Tooling</span>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight">Studio toolkit</h2>
      <p class="mt-2 text-chalk-dim">Our team's shared engine, task board and playtest bots that play builds in Roblox Studio the way real players would. Code in strict Luau with Rojo, Wally, Selene and StyLua.</p>
    </div>
  </div>
</Base>
