---
import Base from '../layouts/Base.astro';
import Stat from '../components/Stat.astro';
import stats from '../data/stats.json';
const cf = stats.climbintel;
---
<Base title="Climb Intel — AI route grading and video coaching for the Kilter Board" description="A live ML product: grades Kilter Board routes, predicts how hard a climb feels for your body, and coaches movement from phone video. Built and run solo." image="/img/climbintel.jpg">
  <section class="grid-bg border-b border-line/60">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 md:pt-28">
      <p class="text-sm uppercase tracking-[0.2em] text-lime">Live product · founder and sole developer</p>
      <h1 class="mt-3 max-w-4xl text-5xl font-semibold leading-[0.95] tracking-tight md:text-7xl">Climb Intel</h1>
      <p class="mt-5 max-w-2xl text-xl text-muted">The same route isn't the same climb for every body. Climb Intel grades Kilter Board routes with ML, predicts how hard a climb will feel for <em>your</em> height, wingspan and reach, and coaches your movement from a phone video.</p>
      <div class="mt-8 flex gap-3">
        <a href="https://climbintel.com" class="rounded-full bg-lime px-5 py-2.5 font-medium text-bg hover:brightness-110">Open climbintel.com ↗</a>
        <a href="https://climbintel.com/architecture.html" class="rounded-full border border-line px-5 py-2.5 font-medium hover:border-text">Architecture</a>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-8 rounded-2xl border border-line bg-surface p-8 sm:grid-cols-2 lg:grid-cols-4">
      <Stat value="137,000" label="graded routes in training" source="https://github.com/shaincarrasco/climbing-ml" />
      <Stat value="72.8%" label="within ±1 V-grade (~90% within ±2), frozen holdout" />
      <Stat value="17" label="body joints tracked from phone video (MediaPipe)" />
      <Stat value={cf.uniques30d} label={`unique visitors, last 30 days (Cloudflare, as of ${cf.asOf})`} />
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-12 px-5 py-6 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">How the grade is made</h2>
      <ol class="mt-4 space-y-3 text-muted">
        <li><b class="text-text">1 · Features.</b> Hold positions, distances, angles and board geometry from the Kilter data, plus the climber's body measurements.</li>
        <li><b class="text-text">2 · Ensemble.</b> XGBoost and LightGBM base models feed a meta-learner.</li>
        <li><b class="text-text">3 · Calibration.</b> Isotonic calibration so a predicted V5 means V5 as often as it should.</li>
        <li><b class="text-text">4 · Honest evaluation.</b> A frozen, leakage-free holdout. Exact grade ~29%; ±1 72.8%; ±2 ~90%. Strongest at V4–V6; V9+ is the open problem.</li>
      </ol>
    </div>
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Video coaching</h2>
      <p class="mt-4 text-muted">Upload a clip from your phone. MediaPipe extracts 17 joints per frame; each move is scored on tension, hip angle, reach and footwork against per-grade medians, and you get feedback move by move.</p>
      <h2 class="mt-10 text-2xl font-semibold tracking-tight">The whole product</h2>
      <p class="mt-4 text-muted">Explore and build routes, live grade predictor, training log and grade pyramid, recommendations, friends and activity feed, leaderboards. Real accounts (bcrypt + Google OAuth), Stripe-ready billing, installable offline-capable PWA.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="text-2xl font-semibold tracking-tight">Stack</h2>
    <div class="mt-4 flex flex-wrap gap-2 text-sm text-muted">{['Python','Flask (13 blueprints)','PostgreSQL','XGBoost','LightGBM','scikit-learn','MediaPipe','Vanilla JS PWA','Stripe','Railway','Cloudflare'].map(s => <span class="rounded bg-surface-2 px-2.5 py-1">{s}</span>)}</div>
    <p class="mt-8 text-sm text-muted">Traffic: {cf.uniques30d} unique visitors and {cf.requests30d} requests in the 30 days to {cf.asOf}, per the Cloudflare dashboard. Page views are not yet measured.</p>
  </section>
</Base>
