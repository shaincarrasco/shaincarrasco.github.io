---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups: [string, string][] = [['product', 'Products'], ['research', 'Research'], ['tools', 'Tools'], ['games', 'Games'], ['archive', 'Earlier']];
---
<Base title="Work — Shain Carrasco" description="Every project, public and private, with the numbers behind it.">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Work</h1>
    <p class="mt-3 max-w-2xl text-muted">Public repos link to code. Private ones show the product and the measurements; ask me for the code.</p>
    {groups.map(([key, label]) => { const items = all.filter((p) => p.data.category === key); return items.length ? (
      <section class="mt-14">
        <h2 class="mb-5 text-sm uppercase tracking-[0.2em] text-muted">{label}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{items.map((p) => <ProjectCard project={p} />)}</div>
      </section>) : null; })}
  </div>
</Base>
