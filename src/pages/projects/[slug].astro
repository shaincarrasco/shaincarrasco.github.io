---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE } from '../../site';
import { Image } from 'astro:assets';
import { asset } from '../../lib/images';
import { STATUS_LABEL } from '../../lib/status';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: CollectionEntry<'projects'> };
const d = p.data;
const { Content } = await render(p);

const all = (await getCollection('projects')).filter((x) => x.data.category !== 'archive' || x.id === p.id).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((x) => x.id === p.id);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];

const statusLabel = STATUS_LABEL[d.status];
const internal = d.live?.startsWith('/');
const liveLabel = !d.live ? null : internal ? 'Open the dashboard' : `Open ${new URL(d.live).host.replace(/^www\./, '')}`;

const url = new URL(`/projects/${p.id}/`, Astro.site).toString();
const author = { '@type': 'Person', name: SITE.name, url: SITE.url };
const jsonLd =
  d.category === 'research'
    ? { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', headline: d.title, description: d.tagline, author, dateCreated: `${d.year}`, url, image: new URL(`/og/project-${p.id}.png`, Astro.site).toString() }
    : d.live && !internal
      ? { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: d.title, description: d.tagline, applicationCategory: 'WebApplication', operatingSystem: 'Any', url: d.live, author, sameAs: d.repo }
      : d.repo
        ? { '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: d.title, description: d.tagline, codeRepository: d.repo, author }
        : { '@context': 'https://schema.org', '@type': 'CreativeWork', name: d.title, description: d.tagline, author, url };
---
<Base title={d.title} description={d.short ?? d.tagline} og={`/og/project-${p.id}.png`} ogAlt={`${d.title}: ${d.short ?? d.tagline}`} jsonLd={jsonLd} type="article">
  <article>
    <header class="mx-auto max-w-[1280px] px-5 pb-12 pt-16 md:pt-24">
      <a href="/projects/" class="text-[15px] text-chalk-dim hover:text-amber">All work</a>
      <h1 class="display mt-6 text-[clamp(52px,8vw,112px)]">{d.title}</h1>
      <p class="mt-6 max-w-[760px] text-[20px] leading-[1.4] md:text-2xl">{d.tagline}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-lg font-semibold">
        {d.live && <a href={d.live} class="link">{liveLabel}</a>}
        {d.repo && <a href={d.repo} class="link">Source on GitHub</a>}
        {!d.repo && d.visibility === 'private' && <span class="font-normal text-chalk-dim">Private repository, code on request</span>}
      </div>
    </header>

    {d.image && (
      <figure class={`mx-auto px-5 ${d.device === 'phone' ? 'max-w-[1280px]' : 'max-w-[1280px]'}`}>
        <div class={d.device === 'phone' ? 'flex justify-center border border-rule bg-night-2 py-10' : ''}>
          <Image
            src={asset(d.image)}
            alt={d.imageAlt ?? `${d.title} screenshot`}
            widths={d.device === 'phone' ? [320, 640] : [640, 960, 1280, 1920, 2560]}
            sizes={d.device === 'phone' ? '320px' : '(min-width: 1320px) 1280px, calc(100vw - 40px)'}
            class={d.device === 'phone' ? 'block h-auto w-[320px] max-w-full border border-rule' : 'block h-auto w-full border border-rule'}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        {d.device === 'figure' && d.image.endsWith('poster.png') && (
          <figcaption class="mt-3 text-[15px] text-chalk-dim"><a href="/skai/poster.pdf" class="link">Open the poster as a PDF</a></figcaption>
        )}
      </figure>
    )}

    <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-16 px-5 pt-16 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="prose-custom min-w-0"><Content /></div>
      <aside class="lg:sticky lg:top-10 lg:self-start" aria-label="Project facts">
        {d.metrics.length > 0 && (
          <div class="flex flex-col gap-7 border-b border-rule pb-8">
            {d.metrics.map((m) => (
              <div>
                <div class="big text-[44px]">{m.value}</div>
                <p class="mt-1 text-[17px] leading-snug">{m.label}</p>
              </div>
            ))}
          </div>
        )}
        <dl class="mt-8 grid grid-cols-[110px_minmax(0,1fr)] gap-x-4 gap-y-3 text-[16px] [overflow-wrap:anywhere]">
          <dt class="text-chalk-dim">Status</dt><dd>{statusLabel}</dd>
          <dt class="text-chalk-dim">Year</dt><dd>{d.year}</dd>
          <dt class="text-chalk-dim">Built with</dt><dd>{d.stack.join(', ')}</dd>
          <dt class="text-chalk-dim">Code</dt><dd>{d.repo ? <a href={d.repo} class="link">{d.repo.replace('https://github.com/', '')}</a> : 'Private'}</dd>
        </dl>
      </aside>
    </div>

    <nav aria-label="More projects" class="mx-auto mt-20 grid max-w-[1280px] gap-6 border-t border-rule px-5 pt-8 sm:grid-cols-2">
      <a href={`/projects/${prev.id}/`} class="group">
        <span class="text-[15px] text-chalk-dim">Previous</span>
        <span class="mt-1 block text-2xl font-semibold group-hover:text-amber">{prev.data.title}</span>
      </a>
      <a href={`/projects/${next.id}/`} class="group sm:text-right">
        <span class="text-[15px] text-chalk-dim">Next</span>
        <span class="mt-1 block text-2xl font-semibold group-hover:text-amber">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>
