---
import Base from '../../layouts/Base.astro';
import Stat from '../../components/Stat.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((x) => x.id === p.id);
const prev = all[(i - 1 + all.length) % all.length], next = all[(i + 1) % all.length];
const accentText = { lime: 'text-lime', cyan: 'text-cyan', magenta: 'text-magenta', amber: 'text-amber' }[d.accent];
---
<Base title={`${d.title} — Shain Carrasco`} description={d.tagline} image={d.image}>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <p class={`text-sm uppercase tracking-[0.2em] ${accentText}`}>{d.category} · {d.status.replace('-', ' ')}{d.visibility === 'private' ? ' · private repo' : ''}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">{d.title}</h1>
    <p class="mt-4 max-w-2xl text-xl text-muted">{d.tagline}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {d.live && <a href={d.live} class="rounded-full bg-text px-4 py-2 text-sm font-medium text-bg hover:brightness-90">Open live ↗</a>}
      {d.repo && <a href={d.repo} class="rounded-full border border-line px-4 py-2 text-sm font-medium hover:border-text">Source on GitHub ↗</a>}
      {!d.repo && d.visibility === 'private' && <span class="rounded-full border border-line px-4 py-2 text-sm text-muted">Private repo — ask me</span>}
    </div>
    {d.image && <img src={d.image} alt={`${d.title} screenshot`} class="mt-10 w-full rounded-2xl border border-line" loading="lazy" />}
    {d.metrics.length > 0 && <div class="mt-10 grid gap-6 rounded-2xl border border-line bg-surface p-6 sm:grid-cols-2 md:grid-cols-4">{d.metrics.map((m) => <Stat value={m.value} label={m.label} source={m.source} accent={d.accent} />)}</div>}
    <div class="prose-custom mt-12"><Content /></div>
    <div class="mt-10 flex flex-wrap gap-2 text-sm text-muted">{d.stack.map((s) => <span class="rounded bg-surface-2 px-2.5 py-1">{s}</span>)}</div>
    <nav class="mt-16 flex justify-between border-t border-line/60 pt-6 text-sm">
      <a href={`/projects/${prev.id}`} class="text-muted hover:text-text">← {prev.data.title}</a>
      <a href={`/projects/${next.id}`} class="text-muted hover:text-text">{next.data.title} →</a>
    </nav>
  </article>
</Base>
<style is:global>
  .prose-custom h2 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; margin: 2.5rem 0 0.75rem; }
  .prose-custom h3 { font-size: 1.125rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  .prose-custom p, .prose-custom li { color: #c9c9d4; line-height: 1.7; }
  .prose-custom p { margin: 0.75rem 0; max-width: 70ch; }
  .prose-custom ul, .prose-custom ol { padding-left: 1.25rem; margin: 0.75rem 0; }
  .prose-custom ul { list-style: disc; } .prose-custom ol { list-style: decimal; }
  .prose-custom a { color: var(--color-lime); text-decoration: underline; text-underline-offset: 3px; }
  .prose-custom code { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-surface-2); padding: 0.1em 0.35em; border-radius: 4px; }
  .prose-custom pre { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 12px; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
  .prose-custom pre code { background: none; padding: 0; }
  .prose-custom table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.95rem; }
  .prose-custom th, .prose-custom td { border-bottom: 1px solid var(--color-line); padding: 0.5rem 0.75rem; text-align: left; }
  .prose-custom th { color: var(--color-muted); font-weight: 500; }
</style>
