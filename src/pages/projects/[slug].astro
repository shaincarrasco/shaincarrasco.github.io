---
import Base from '../../layouts/Base.astro';
import Stat from '../../components/Stat.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((x) => x.id === p.id);
const prev = all[(i - 1 + all.length) % all.length], next = all[(i + 1) % all.length];
const accentText = 'text-amber';
---
<Base title={`${d.title} — Shain Carrasco`} description={d.tagline} image={d.image}>
  <article class="mx-auto max-w-4xl px-5 py-16">
    <p class={`text-sm uppercase tracking-[0.2em] ${accentText}`}>{d.category} · {d.status.replace('-', ' ')}{d.visibility === 'private' ? ' · private repo' : ''}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">{d.title}</h1>
    <p class="mt-4 max-w-2xl text-xl text-chalk-dim">{d.tagline}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {d.live && <a href={d.live} class=" bg-chalk px-4 py-2 text-sm font-medium text-night hover:brightness-90">Open live ↗</a>}
      {d.repo && <a href={d.repo} class=" border border-rule px-4 py-2 text-sm font-medium hover:border-chalk">Source on GitHub ↗</a>}
      {!d.repo && d.visibility === 'private' && <span class=" border border-rule px-4 py-2 text-sm text-chalk-dim">Private repo — ask me</span>}
    </div>
    {d.image && <img src={d.image} alt={`${d.title} screenshot`} class="mt-10 w-full border border-rule" loading="lazy" />}
    {d.metrics.length > 0 && <div class="mt-10 grid gap-6  border border-rule bg-night-2 p-6 sm:grid-cols-2 md:grid-cols-4">{d.metrics.map((m) => <Stat value={m.value} label={m.label} source={m.source} accent={d.accent} />)}</div>}
    <div class="prose-custom mt-12"><Content /></div>
    <div class="mt-10 flex flex-wrap gap-2 text-sm text-chalk-dim">{d.stack.map((s) => <span class="rounded bg-night-2 px-2.5 py-1">{s}</span>)}</div>
    <nav class="mt-16 flex justify-between border-t border-rule pt-6 text-sm">
      <a href={`/projects/${prev.id}`} class="text-chalk-dim hover:text-amber">← {prev.data.title}</a>
      <a href={`/projects/${next.id}`} class="text-chalk-dim hover:text-amber">{next.data.title} →</a>
    </nav>
  </article>
</Base>
