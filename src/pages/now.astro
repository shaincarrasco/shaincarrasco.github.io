---
import Base from '../layouts/Base.astro';
const updated = '2026-11-08';
const items = [
  ['This month', 'HoopLab live for the 2026-27 college basketball season', '/projects/hooplab'],
  ['This month', 'Climb Intel: push V9+ accuracy, the open problem at the top grades', '/climbintel'],
  ['Next', 'WildAtlas naming decision and globe v1 with GBIF data', '/projects/wildatlas'],
  ['Next', 'BrickVision real-photo calibration set and first real-photo accuracy numbers', '/projects/brickvision'],
  ['Next', 'Workbench: placesnap, conduit, tollgate, live-wire', '/tools'],
  ['Next', 'LipRead tested on a real iPhone and Android device', '/projects/lipread'],
  ['Later', 'Slice phase 1', '/projects/slice'],
  ['Later', 'Scrap City, Be a Stone, Canopy Bureau public releases', '/roblox'],
];
---
<Base title="Now — Shain Carrasco" description="What I'm working on right now and what's next.">
  <div class="mx-auto max-w-4xl px-5 py-16">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Now</h1>
    <p class="mt-3 text-chalk-dim">What I'm working on. Updated <span class="num">{updated}</span>.</p>
    <table class="mt-10 w-full text-left">
      <tbody>{items.map(([h, t, href]) => <tr class="border-b border-rule"><td class="w-28 py-3 pr-4 text-sm text-chalk-dim">{h}</td><td class="py-3"><a href={href} class="hover:text-amber">{t}</a></td></tr>)}</tbody>
    </table>
  </div>
</Base>
