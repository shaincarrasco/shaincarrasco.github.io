---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import stats from '../data/stats.json';
import SkaiFeature from '../components/SkaiFeature.astro';
import Row from '../components/Row.astro';
import { SITE } from '../site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rows = all.filter((p) => p.data.category !== 'archive');
const earlier = all.filter((p) => p.data.category === 'archive');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: SITE.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    url: SITE.url,
    jobTitle: SITE.role,
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
    affiliation: [{ '@type': 'Organization', name: 'NSF-Simons AI Institute for the Sky (SkAI)' }],
    alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.school },
    sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
    knowsAbout: ['Machine learning', 'Astronomy', 'Telescope scheduling', 'Python', 'TypeScript', 'Sports analytics', 'Roblox'],
  },
};
---
<Base jsonLd={jsonLd} type="profile">
  <!-- Hero -->
  <section class="mx-auto grid max-w-[1280px] items-center gap-12 px-5 pb-20 pt-24 md:grid-cols-[minmax(0,620px)_1fr] md:pt-36">
    <div>
      <h1 class="display text-[clamp(72px,11vw,152px)]">Shain<br />Carrasco</h1>
      <p class="mt-10 max-w-[560px] text-[22px] leading-[1.4] md:text-2xl">
        Software developer and student in Chicago. This summer I was a researcher at the SkAI Institute, scoring telescope
        schedules on 105,889 Dark Energy Survey exposures. I also run <a href="https://climbintel.com" class="link">Climb Intel</a>,
        used by about {stats.climbintel.uniques30dLong} people a month, and build college basketball analytics, a 3D globe of
        life on Earth, and Roblox games.
      </p>
    </div>
    <figure class="mx-auto w-full max-w-[600px]">
      <video id="globe" class="globe aspect-square w-full" muted loop playsinline preload="none" width="720" height="720" poster="/skai/des-globe-poster.webp" aria-label="The Dark Energy Survey's pointings on a slowly rotating celestial sphere">
        <source src="/skai/des-globe.webm" type="video/webm" />
        <source src="/skai/des-globe.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-3 text-center text-[15px] leading-snug text-chalk-dim">
        Every Dark Energy Survey pointing, 2013–2019, on the celestial sphere. A figure from my SkAI work.
      </figcaption>
    </figure>
  </section>

  <script is:inline>
    // Start the globe after the page has loaded, and only if the visitor has not asked for reduced motion.
    addEventListener('load', () => {
      const v = document.getElementById('globe');
      if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) { v.preload = 'auto'; v.play().catch(() => {}); }
    });
  </script>
  <SkaiFeature />

  <!-- Work logbook -->
  <section id="work" class="mx-auto max-w-[1280px] px-5 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-rule pb-7">
      <h2 class="h2 text-[40px] md:text-[56px]">Work</h2>
      <p class="max-w-[420px] text-[15px] leading-snug text-chalk-dim md:text-right">
        Everything since 2022. Each number was measured; the project page says how. Private repos show the product, not the code.
      </p>
    </div>
    <ol>{rows.map((p) => <Row p={p} />)}</ol>
    {earlier.length > 0 && (
      <p class="mt-8 text-[15px] text-chalk-dim">
        Earlier: {earlier.map((p, i) => (<><a href={p.data.repo ?? `/projects/${p.id}/`} class="link">{p.data.title}</a>{i < earlier.length - 1 ? ', ' : ''}</>))}
      </p>
    )}
  </section>
</Base>
