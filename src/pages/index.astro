---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured).slice(0, 3);
const rest = all.filter((p) => !p.data.featured && p.data.status !== 'archived');
---
<Base title="Shain Carrasco — I build things that work" description="ML products, research tools and games — shipped, measured, in use. Climb Intel, HoopLab, WildAtlas, telescope-scheduler metrics, and the tools behind them.">
  <section class="grid-bg border-b border-line/60">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 md:pb-24 md:pt-32">
      <p class="mb-4 text-sm uppercase tracking-[0.2em] text-muted">Shain Carrasco · Chicago</p>
      <h1 class="max-w-4xl text-5xl font-semibold leading-[0.95] tracking-tight md:text-7xl">I build things that <span class="text-lime glow-lime">work</span>.</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">ML products, research tools and games — shipped, measured, in use. Every number on this site links to where it was measured.</p>
      <div class="mt-8 flex gap-3">
        <a href="/projects" class="rounded-full bg-lime px-5 py-2.5 font-medium text-bg hover:brightness-110">See the work</a>
        <a href="/climbintel" class="rounded-full border border-line px-5 py-2.5 font-medium hover:border-text">Climb Intel ↗</a>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-4 md:grid-cols-3 md:auto-rows-fr">
      {featured.map((p, i) => <ProjectCard project={p} big={i === 0} />)}
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 pb-8">
    <h2 class="mb-6 text-sm uppercase tracking-[0.2em] text-muted">More work</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{rest.map((p) => <ProjectCard project={p} />)}</div>
  </section>
</Base>
