---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import stats from '../data/stats.json';
import SkaiFeature from '../components/SkaiFeature.astro';
import Row from '../components/Row.astro';
import Feature from '../components/Feature.astro';
import GamesFeature from '../components/GamesFeature.astro';
import Collection from '../components/Collection.astro';
import { SITE } from '../site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const FEATURED = ['climb-intel', 'upset', 'wildatlas', 'lipread'];
const featured = FEATURED.map((id) => all.find((p) => p.id === id)!).filter(Boolean);
const rows = all.filter((p) => !FEATURED.includes(p.id) && !['skai-metrics', 'roblox-games'].includes(p.id) && p.data.status !== 'planning' && p.data.category !== 'archive');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: SITE.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    url: SITE.url,
    jobTitle: SITE.role,
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
    affiliation: [{ '@type': 'Organization', name: 'NSF-Simons AI Institute for the Sky (SkAI)' }],
    alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.school },
    sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
    knowsAbout: ['Machine learning', 'Astronomy', 'Telescope scheduling', 'Python', 'TypeScript', 'Sports analytics', 'Roblox'],
  },
};
---
<Base jsonLd={jsonLd} type="profile">
  <!-- Hero -->
  <section class="mx-auto grid max-w-[1280px] items-end gap-8 px-5 pb-12 pt-20 md:grid-cols-[minmax(0,1fr)_minmax(0,520px)] md:gap-12 md:pt-28">
    <h1 class="display text-[clamp(64px,10.5vw,148px)]">Shain<br />Carrasco</h1>
    <p class="max-w-[560px] text-[20px] leading-[1.4] md:pb-3 md:text-[22px]">
      Software developer and student in Chicago. This summer I was a researcher at the SkAI Institute, building a score for
      how good a night of telescope observing was. I also run <a href="https://climbintel.com" class="link">Climb Intel</a>,
      which had {stats.climbintel.uniques30dLong} unique visitors in the last 30 days, make Roblox games, and build college
      basketball analytics and a 3D globe of life on Earth.
    </p>
  </section>
  <Collection />

  <script is:inline>
    // Start the globe after the page has loaded, and only if the visitor has not asked for reduced motion.
    addEventListener('load', () => {
      const v = document.getElementById('globe');
      if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) { v.preload = 'auto'; v.play().catch(() => {}); }
    });
  </script>
  <SkaiFeature />

  <!-- Work -->
  <section id="work" class="mx-auto max-w-[1280px] px-5 py-24" aria-labelledby="work-title">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-rule pb-7">
      <h2 id="work-title" class="h2 text-[40px] md:text-[56px]">Selected work</h2>
      <p class="max-w-[420px] text-[15px] leading-snug text-chalk-dim md:text-right">
        Numbers come from each project's own tests, evaluations or analytics; the case study says how.
      </p>
    </div>
    <ol>{featured.map((p, i) => <Feature p={p} eager={i === 0} />)}</ol>

  </section>

  <GamesFeature />

  <section class="mx-auto max-w-[1280px] px-5 pb-24" aria-labelledby="more-title">
    <h2 id="more-title" class="border-b border-rule pb-5 text-3xl font-semibold tracking-[-0.02em]">More projects</h2>
    <ol>{rows.map((p) => <Row p={p} />)}</ol>
    <p class="mt-8 text-[17px]"><a href="/projects/" class="link">Everything, including planning-stage and earlier projects</a></p>
  </section>
</Base>
